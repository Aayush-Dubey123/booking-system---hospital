# CityCare Backend Environment Variables

# JWT & Security
secret=your_super_secret_jwt_key_here
algorithm=HS256

# Google Gemini API Key (for Chatbot)
api_key=your_gemini_api_key_here
API_KEY=your_gemini_api_key_here

# Cloudinary (for file uploads / prescriptions)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# URLs & Ports (Render automatically assigns PORT)
BACKEND_URL=https://your-backend.onrender.com
# FRONTEND_URL: Allowed CORS origin for Vercel (e.g. https://your-frontend.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app,http://localhost:5173

# Database (Use MongoDB Atlas connection string for production)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=citycare
MONGODB_NAME=citycare

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Logging
LOG_LEVEL=INFO
